{
    "extends": "@edgarguzman/typescript/next.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "next-env.d.ts",
        "next.config.mjs",
        ".next/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
