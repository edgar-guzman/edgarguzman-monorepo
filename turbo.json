{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "start": {
            "dependsOn": ["^start"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "gen": {
            "dependsOn": ["^gen"]
        }
    }
}
