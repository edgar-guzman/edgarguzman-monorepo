{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
      "dev": {
        "dependsOn": ["^dev"],
        "cache": false,
        "persistent": true
      },
      "build": {
        "dependsOn": ["^build"],
        "cache": false
      },
      "start": {
        "dependsOn": ["^start"],
        "cache": false
      },
      "lint": {
        "dependsOn": ["^lint"],
        "cache": false
      }
  }
}
