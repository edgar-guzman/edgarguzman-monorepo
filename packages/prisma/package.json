{
    "name": "@edgarguzman/prisma",
    "version": "0.0.0",
    "private": true,
    "exports": {
        ".": "./src/root.ts"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "db:generate": "prisma generate --schema=./src/schema",
        "db:migrate:dev": "prisma migrate dev --schema=./src/schema --skip-generate",
        "db:reset": "prisma migrate reset --schema=./src/schema",
        "db:studio": "prisma studio --schema=./src/schema --browser none",
        "db:push": "prisma db push --schema=./src/schema --skip-generate",
        "db:format": "prisma format --schema=./src/schema",
        "db:pull": "prisma db pull --schema=./src/schema"
    },
    "dependencies": {
        "@prisma/client": "^6.6.0"
    },
    "devDependencies": {
        "@edgarguzman/eslint": "workspace:*",
        "@edgarguzman/typescript": "workspace:*",
        "@types/node": "^22.14.0",
        "eslint": "^8.57.0",
        "prisma": "6.6.0",
        "typescript": "^5.7.2"
    }
}
